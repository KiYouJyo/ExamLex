<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ExamLex.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ExamLex">
    <Grid x:Name="Root" Background="#192222" RequestedTheme="Dark">
      <Grid.RowDefinitions>
        <RowDefinition Height="38"/>
        <RowDefinition Height="54"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="52"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button x:Name="BackButton" Grid.Column="0" Visibility="Collapsed"
                Margin="10,5,0,5" Width="38" Height="38" BorderThickness="0"
                Background="Transparent" Click="OnBackClicked"
                AutomationProperties.Name="返回词典首页" ToolTipService.ToolTip="返回词典">
          <FontIcon Glyph="&#xE72B;" FontSize="19"/>
        </Button>
        <Grid x:Name="TitleDragRegion" Grid.Column="1" Background="Transparent">
          <TextBlock x:Name="HeaderTextBlock" Text="ExamLex" FontFamily="Times New Roman"
                     FontSize="20" FontWeight="Bold" VerticalAlignment="Bottom" Margin="20,0,0,4" Opacity="0.9"/>
        </Grid>
      </Grid>

      <Border x:Name="SearchHost" Grid.Row="1" Margin="16,4,16,0"
              CornerRadius="6" BorderThickness="1"
              Background="#252525" BorderBrush="#3A3A3A">
        <TextBox x:Name="SearchBox" PlaceholderText="输入要查询的英语单词…"
                 TextChanged="OnSearchTextChanged" BorderThickness="0"
                 Background="Transparent" FontSize="17" FontWeight="Normal"
                 Padding="10,0" VerticalContentAlignment="Center"/>
      </Border>

      <Grid x:Name="HomePanel" Grid.Row="2" Padding="16,0">
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Spacing="7">
          <FontIcon Glyph="&#xE8F1;" FontSize="60" Opacity="0.19"/>
          
          <TextBlock x:Name="EmptyDescription"
                     Text="还没有安装词库。可在设置 → 关于中检查 ExamLex-Lexicon 更新。"
                     TextWrapping="Wrap" TextAlignment="Center" Opacity="0.42" FontSize="11"
                     MaxWidth="290"/>
        </StackPanel>
        <ScrollViewer x:Name="ResultsScroll" VerticalScrollBarVisibility="Auto"
                      Visibility="Collapsed">
          <StackPanel x:Name="ResultsPanel" Spacing="10" Padding="0,8,0,14"/>
        </ScrollViewer>
      </Grid>
      <Frame x:Name="ContentFrame" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed"
            />

      <Grid x:Name="Footer" Grid.Row="3" Background="#1F1F1F">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Height="1" VerticalAlignment="Top" Background="#343434" Grid.ColumnSpan="5"/>
        <Button x:Name="SettingsButton" Grid.Column="0" Click="OnSettingsClicked"
                Width="42" Height="36" Margin="8,8,0,8" Background="Transparent"
                BorderThickness="0" ToolTipService.ToolTip="设置"
                AutomationProperties.Name="设置">
          <FontIcon Glyph="&#xE713;" FontSize="17"/>
        </Button>
        <Button x:Name="CalculatorButton" Grid.Column="2" Click="OnCalculatorClicked"
                Margin="4,8,0,8" Width="42" Height="36" Background="Transparent"
                BorderThickness="0" ToolTipService.ToolTip="托福 / 雅思算分器"
                AutomationProperties.Name="英语考试算分器">
          <FontIcon Glyph="&#xE8EF;" FontSize="17"/>
        </Button>
        <Button Grid.Column="3" Click="OnGlossaryClicked"
                Margin="4,8,0,8" Width="42" Height="36" Background="Transparent"
                BorderThickness="0" ToolTipService.ToolTip="生词本">
          <FontIcon Glyph="&#xE8F1;" FontSize="17"/>
        </Button>
        <ToggleButton x:Name="PinToggle" Grid.Column="4" Click="OnPinClicked"
                      Margin="4,8,8,8" Width="42" Height="36"
                      Background="Transparent" BorderThickness="0"
                      ToolTipService.ToolTip="窗口置顶">
          <FontIcon Glyph="&#xE718;" FontSize="17"/>
        </ToggleButton>
      </Grid>
    </Grid>
</Window>
