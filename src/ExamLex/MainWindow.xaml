<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ExamLex.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    Title="ExamLex">
    <!-- Flint3/Views/FlintFullPage.xaml structure: 38 / Auto / * / Auto -->
    <Grid x:Name="Root" Background="Transparent" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Original Flint title line, with brand text substitution -->
        <Grid x:Name="TitleDragRegion" Grid.Row="0" Background="Transparent">
            <TextBlock x:Name="HeaderTextBlock" Text="ExamLex" FontFamily="Times New Roman"
                       Margin="20,0,0,4" FontWeight="Bold" FontSize="20"
                       VerticalAlignment="Bottom" Opacity="0.9"/>
            <Button x:Name="BackButton" Visibility="Collapsed" Click="OnBackClicked"
                    HorizontalAlignment="Left" Width="35" Height="32" Background="Transparent"
                    BorderThickness="0" AutomationProperties.Name="返回词典">
                <FontIcon Glyph="&#xE72B;"/>
            </Button>
        </Grid>
        <!-- Exact Flint search row geometry; template comes from original CustomControlStyle.xaml -->
        <Grid x:Name="SearchHost" Grid.Row="1" Padding="16,0" Margin="0,4,0,0">
            <TextBox x:Name="SearchBox" Style="{StaticResource ModernTextBoxStyle}"
                     TextChanged="OnSearchTextChanged"/>
            <TextBlock x:Name="SearchHint" Text="开始键入..." Margin="16,6,0,0" FontSize="17.5"
                       Opacity="0.3" HorizontalAlignment="Left" IsHitTestVisible="False"
                       VerticalAlignment="Top"/>
        </Grid>
        <Grid x:Name="HomePanel" Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Flint's centered 72-DIP empty graphic, with original ExamLex brand artwork -->
            <Grid x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/Square71x71Logo.png"
                       Height="72" Width="72" Opacity="0.2"/>
                <TextBlock x:Name="EmptyDescription" Visibility="Collapsed"/>
            </Grid>
            <ScrollViewer x:Name="ResultsScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel x:Name="ResultsPanel" Spacing="8" Padding="0,8,2,8"/>
            </ScrollViewer>
        </Grid>
        <!-- Flint footer: Settings | spacer | added calculator | Glossary | Pin -->
        <Grid x:Name="Footer" Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="52"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.ColumnSpan="5" Height="1" HorizontalAlignment="Stretch"
                       VerticalAlignment="Top" Fill="{ThemeResource ControlElevationBorderBrush}"/>
            <Button x:Name="SettingsButton" Grid.Column="0" Margin="8,8,0,8"
                    Background="Transparent" BorderBrush="Transparent" Click="OnSettingsClicked"
                    ToolTipService.ToolTip="设置">
                <muxc:AnimatedIcon Height="22" Width="22" Opacity="0.8">
                    <muxc:AnimatedIcon.Source>
                        <animatedvisuals:AnimatedSettingsVisualSource/>
                    </muxc:AnimatedIcon.Source>
                    <muxc:AnimatedIcon.FallbackIconSource>
                        <muxc:SymbolIconSource Symbol="Setting"/>
                    </muxc:AnimatedIcon.FallbackIconSource>
                </muxc:AnimatedIcon>
            </Button>
            <Button x:Name="CalculatorButton" Grid.Column="2" Margin="4,8,0,8"
                    Background="Transparent" BorderBrush="Transparent" Click="OnCalculatorClicked"
                    ToolTipService.ToolTip="托福 / 雅思算分器">
                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8EF;"
                          FontSize="16" Height="22" Width="22" Opacity="0.8"/>
            </Button>
            <Button Grid.Column="3" Margin="4,8,0,8"
                    Background="Transparent" BorderBrush="Transparent" Click="OnGlossaryClicked"
                    ToolTipService.ToolTip="生词本">
                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE82D;"
                          FontSize="16" Height="22" Width="22" Opacity="0.8"/>
            </Button>

        </Grid>
        <!-- Page overlays all four rows, as Flint MainFrame spans the top-level Window grid. -->
        <Frame x:Name="ContentFrame" Grid.Row="0" Grid.RowSpan="4" Visibility="Collapsed"/>
        <!-- Shared window-level pin: always topmost in visual tree and bottom-right,
             independent of the active Flint-style page and its own navigation bar. -->
        <ToggleButton x:Name="PinToggle" Grid.Row="0" Grid.RowSpan="4"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="4,8,8,8" MinWidth="40" MinHeight="36"
                      Background="Transparent" BorderBrush="Transparent" Click="OnPinClicked"
                      ToolTipService.ToolTip="窗口置顶" AutomationProperties.Name="窗口置顶">
          <Grid Width="22" Height="22">
            <FontIcon x:Name="PinNormalIcon" FontFamily="{StaticResource SymbolThemeFontFamily}"
                      Glyph="&#xE141;" FontSize="16" Width="22" Height="22" Opacity="0.8"/>
            <FontIcon x:Name="PinActiveIcon" FontFamily="{StaticResource SymbolThemeFontFamily}"
                      Glyph="&#xE196;" FontSize="16" Width="22" Height="22" Opacity="0.8"
                      Visibility="Collapsed"/>
          </Grid>
        </ToggleButton>
    </Grid>
</Window>