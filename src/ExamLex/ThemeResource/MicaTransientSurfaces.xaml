<?xml version="1.0" encoding="utf-8"?>
<!-- Theme-aware Fluent Acrylic dropdown surfaces: high tint opacity ensures no
     readability-breaking bleed-through of the content under the options list.
     WinUI retains OS fallback when transparency is disabled. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <AcrylicBrush x:Key="ComboBoxDropDownBackground"
         TintColor="#212A30" TintOpacity="0.95" TintLuminosityOpacity="0.94"
         FallbackColor="#26343A"/>
      <AcrylicBrush x:Key="FlyoutPresenterBackground"
         TintColor="#212A30" TintOpacity="0.95" TintLuminosityOpacity="0.94"
         FallbackColor="#26343A"/>
      <AcrylicBrush x:Key="MenuFlyoutPresenterBackground"
         TintColor="#212A30" TintOpacity="0.95" TintLuminosityOpacity="0.94"
         FallbackColor="#26343A"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <AcrylicBrush x:Key="ComboBoxDropDownBackground"
         TintColor="#F0FAFD" TintOpacity="0.96" TintLuminosityOpacity="0.95"
         FallbackColor="#F0F7FA"/>
      <AcrylicBrush x:Key="FlyoutPresenterBackground"
         TintColor="#F0FAFD" TintOpacity="0.96" TintLuminosityOpacity="0.95"
         FallbackColor="#F0F7FA"/>
      <AcrylicBrush x:Key="MenuFlyoutPresenterBackground"
         TintColor="#F0FAFD" TintOpacity="0.96" TintLuminosityOpacity="0.95"
         FallbackColor="#F0F7FA"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
      <AcrylicBrush x:Key="ComboBoxDropDownBackground"
         TintColor="#212A30" TintOpacity="0.95" TintLuminosityOpacity="0.94"
         FallbackColor="#26343A"/>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
