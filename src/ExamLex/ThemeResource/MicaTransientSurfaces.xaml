<?xml version="1.0" encoding="utf-8"?>
<!-- WinUI transient surface overrides.
     ComboBox lists MUST be fully opaque for readability.
     ContentDialog tinted surfaces reveal the OS Mica backdrop applied by
     MicaSurfaceService; Windows handles fallback if transparency is disabled. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="ContentDialogBackground" Color="#BE262A2C"/>
      <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FF2A2C2D"/>
      <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#EA292E30"/>
      <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#EA292E30"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="ContentDialogBackground" Color="#CBF4F6F8"/>
      <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFF8F8F9"/>
      <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#EAF5F5F5"/>
      <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#EAF5F5F5"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="ContentDialogBackground" Color="#BE262A2C"/>
      <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FF2A2C2D"/>
      <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#EA292E30"/>
      <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#EA292E30"/>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>