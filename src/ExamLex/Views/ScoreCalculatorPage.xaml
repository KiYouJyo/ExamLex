<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="ExamLex.Views.ScoreCalculatorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ExamLex.Controls"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
      Background="Transparent">
    <!-- Follow Flint's page architecture: title (38 DIP) / scrollable content / footer -->
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="38"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid x:Name="PageDragRegion" Grid.Row="0" Background="Transparent">
        <TextBlock Text="Calculator" FontFamily="Times New Roman" Margin="20,0,0,4"
                   FontWeight="Bold" FontSize="20" VerticalAlignment="Bottom" Opacity="0.9"/>
      </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="16,12,16,24" MaxWidth="800" HorizontalAlignment="Stretch" Spacing="18">
            <StackPanel Spacing="6">
                <TextBlock Text="输入已获各科标准分，实时合成总分；CEFR 仅供参考。"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <ComboBox x:Name="ExamSelector" Header="选择考试类型" SelectedIndex="0"
                      HorizontalAlignment="Stretch" SelectionChanged="OnExamChanged">
                <ComboBoxItem Content="TOEFL iBT · 2026 新制"/>
                <ComboBoxItem Content="IELTS · 雅思"/>
            </ComboBox>
            <Grid ColumnSpacing="20" RowSpacing="15">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <NumberBox x:Name="ReadingBox" Grid.Row="0" Grid.Column="0" Header="Reading / 阅读"
                           SpinButtonPlacementMode="Inline" ValueChanged="OnScoreChanged"/>
                <NumberBox x:Name="ListeningBox" Grid.Row="0" Grid.Column="1" Header="Listening / 听力"
                           SpinButtonPlacementMode="Inline" ValueChanged="OnScoreChanged"/>
                <NumberBox x:Name="SpeakingBox" Grid.Row="1" Grid.Column="0" Header="Speaking / 口语"
                           SpinButtonPlacementMode="Inline" ValueChanged="OnScoreChanged"/>
                <NumberBox x:Name="WritingBox" Grid.Row="1" Grid.Column="1" Header="Writing / 写作"
                           SpinButtonPlacementMode="Inline" ValueChanged="OnScoreChanged"/>
            </Grid>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="9">
                    <TextBlock Text="总分" FontSize="14" Opacity="0.75"/>
                    <TextBlock x:Name="ResultText" Text="—" FontSize="34" FontWeight="SemiBold"/>
                    <TextBlock x:Name="CefrText" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ComparisonText" FontSize="13" Opacity="0.75" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="RuleText" FontSize="13" Opacity="0.7" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
    <!-- Exact Flint footer pattern, including 22-DIP animated back icon -->
    <Grid Grid.Row="2" HorizontalAlignment="Stretch">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Rectangle Grid.ColumnSpan="3" Height="1" HorizontalAlignment="Stretch"
                 VerticalAlignment="Top" Fill="{ThemeResource ControlElevationBorderBrush}"/>
      <Button Grid.Column="0" Margin="8,8,0,8" Background="Transparent" BorderBrush="Transparent"
              VerticalAlignment="Center" Click="OnBackClicked">
        <ToolTipService.ToolTip>
          <ToolTip><TextBlock><Run Text="back" FontWeight="Bold"/><Run Text="/bæk/"/>
            <Run Text="adverb" FontStyle="Italic"/><Run Text="返回"/></TextBlock></ToolTip>
        </ToolTipService.ToolTip>
        <muxc:AnimatedIcon Height="22" Width="22" Opacity="0.8">
          <muxc:AnimatedIcon.Source><animatedvisuals:AnimatedBackVisualSource/></muxc:AnimatedIcon.Source>
          <muxc:AnimatedIcon.FallbackIconSource><muxc:SymbolIconSource Symbol="Back"/></muxc:AnimatedIcon.FallbackIconSource>
        </muxc:AnimatedIcon>
      </Button>
      <controls:PinToggleControl Grid.Column="2" Margin="4,8,8,8"/>
    </Grid>
    </Grid>
</Page>
