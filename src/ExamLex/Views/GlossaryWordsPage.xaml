<?xml version="1.0" encoding="utf-8"?>
<!-- Flint3/Views/GlossaryWordsPage.xaml: original title/filter/footer structure;
     word-entry content adapted to ExamLex local lexical store (allowed exception). -->
<Page x:Class="ExamLex.Views.GlossaryWordsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ExamLex.Controls"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
      Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Original Flint Glossary > collection title -->
        <Grid x:Name="PageDragRegion" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Glossary" FontFamily="Times New Roman" Margin="20,0,0,4"
                       FontWeight="Bold" FontSize="20" VerticalAlignment="Bottom" Opacity="0.7"/>
            <FontIcon Grid.Column="1" FontFamily="{StaticResource SymbolThemeFontFamily}"
                      Glyph="&#xE00F;" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                      FontSize="14" FontWeight="Bold" Opacity="0.5" Margin="4,0,4,8"/>
            <TextBlock x:Name="GlossaryTitle" Grid.Column="2" Margin="0,0,120,5"
                       FontSize="16" FontWeight="Bold" Opacity="0.9" TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
        </Grid>
        <Grid Grid.Row="1" Padding="16,8,16,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" CornerRadius="4" Margin="1,0,0,0" Padding="12,0,12,0"
                    Height="30" MinWidth="64" VerticalAlignment="Center" IsEnabled="False" ToolTipService.ToolTip="颜色筛选">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE790;" FontSize="14"/>
                    <TextBlock Text="颜色" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBox x:Name="FilterWordTextBox" Grid.Column="4" Width="196"
                     PlaceholderText="查找生词" FontSize="14" FontWeight="Medium"
                     Padding="12,8,4,2" Height="34" MinHeight="0"
                     BorderBrush="Transparent" BorderThickness="0"
                     VerticalAlignment="Center" TextChanged="OnFilterChanged"/>
        </Grid>
        <Grid Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border x:Name="PropertiesPanel" Visibility="Collapsed" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Margin="12" Padding="12" CornerRadius="6"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <TextBlock x:Name="PropertiesSummary" TextWrapping="Wrap"/>
            </Border>
            <StackPanel x:Name="NoWordsState" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="没有找到" FontSize="13" Opacity="0.3"/>
                <TextBlock Text="生词" FontSize="13" Opacity="0.3"/>
            </StackPanel>
            <ListView x:Name="GlossaryWordsListView" HorizontalContentAlignment="Stretch"
                      Padding="0,0,4,8" SelectionMode="None"/>
        </Grid>
        <Grid Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.ColumnSpan="7" Height="1" HorizontalAlignment="Stretch"
                       VerticalAlignment="Top" Fill="{ThemeResource ControlElevationBorderBrush}"/>
            <Button Grid.Column="0" Margin="8,8,0,8" Background="Transparent"
                    BorderBrush="Transparent" VerticalAlignment="Center"
                    Click="OnBackClicked" ToolTipService.ToolTip="返回生词本">
                <muxc:AnimatedIcon Height="22" Width="22" Opacity="0.8">
                    <muxc:AnimatedIcon.Source>
                        <animatedvisuals:AnimatedBackVisualSource/>
                    </muxc:AnimatedIcon.Source>
                    <muxc:AnimatedIcon.FallbackIconSource>
                        <muxc:SymbolIconSource Symbol="Back"/>
                    </muxc:AnimatedIcon.FallbackIconSource>
                </muxc:AnimatedIcon>
            </Button>
            <Button Grid.Column="4" Margin="4,8,0,8" Background="Transparent"
                    BorderBrush="Transparent" VerticalAlignment="Center"
                    Click="OnSortClicked" ToolTipService.ToolTip="按字母排序">
                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE174;"
                          FontSize="16" Height="22" Width="22" Opacity="0.8"/>
            </Button>
            <Button Grid.Column="5" Margin="4,8,0,8" Background="Transparent"
                    BorderBrush="Transparent" VerticalAlignment="Center"
                    Click="OnPropertiesClicked" ToolTipService.ToolTip="生词本属性">
                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE946;"
                          FontSize="16" Height="22" Width="22" Opacity="0.8"/>
            </Button>
            <controls:PinToggleControl Grid.Column="6" Margin="4,8,8,8"/>
        </Grid>
    </Grid>
</Page>