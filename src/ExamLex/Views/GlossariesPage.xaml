<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ExamLex.Views.GlossariesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ExamLex.Controls" 
    xmlns:labs="using:CommunityToolkit.WinUI.Controls" 
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls" 
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:models="using:ExamLex.Models"
    
    Background="Transparent" NavigationCacheMode="Required">

    

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--Title-->
        <Grid x:Name="PageDragRegion" Grid.Row="0" Background="Transparent">
            <TextBlock Text="Glossary" FontFamily="Times New Roman" Margin="20,0,0,4" FontWeight="Bold" FontSize="20" VerticalAlignment="Bottom" Opacity="0.9"/>
        </Grid>

        <!--Glossary Tab-->
        <Grid Grid.Row="1" Margin="0,-4,0,8" Background="Transparent">
            <labs:Segmented x:Name="GlossaryTabSegmented" SelectionMode="Single" SelectedIndex="0" SelectionChanged="OnTabChanged" HorizontalAlignment="Center" VerticalAlignment="Center">
                <labs:SegmentedItem Content="我的生词本" FontSize="14"/>
                <labs:SegmentedItem Content="扩展生词本" FontSize="14"/>
            </labs:Segmented>
        </Grid>

        <!-- Original Flint GlossariesPage My/Extra section layout; data uses ExamLex local favorites. -->
        <Grid x:Name="MyGlossariesGrid" Grid.Row="2">
            <StackPanel x:Name="NoCollectionsState" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8" Margin="0,-20,0,0" Visibility="Collapsed">
                <Image Source="ms-appx:///Assets/Square71x71Logo.png" Height="72" Width="72" Opacity="1"/>
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="欢迎使用生词本" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Spacing="4" Opacity="0.8" Margin="0,0,0,2">
                        <TextBlock Text="点击右下方的" FontSize="12"/>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE82E;" FontSize="12"/>
                        <TextBlock Text="按钮" FontSize="12"/>
                    </StackPanel>
                    <TextBlock Text="创建第一个生词本吧！" FontSize="12" Opacity="0.8"/>
                </StackPanel>
            </StackPanel>
            <ScrollViewer>
                <muxc:ItemsRepeater Margin="16,0,16,8" HorizontalAlignment="Center"
                                    ItemsSource="{x:Bind MyGlossaries,Mode=OneWay}">
                    <muxc:ItemsRepeater.Layout>
                        <muxc:UniformGridLayout Orientation="Horizontal" MinItemWidth="96" MinItemHeight="132"
                                                MinColumnSpacing="6" MinRowSpacing="6" ItemsStretch="Uniform"/>
                    </muxc:ItemsRepeater.Layout>
                    <DataTemplate x:DataType="models:GlossaryMyModel">
                        <Button DataContext="{x:Bind}" Click="OnClickGoMyGlossary" Padding="0,0" CornerRadius="4"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <Button.Content>
                                <Grid BorderThickness="0,0,0,0" CornerRadius="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="{x:Bind GlossaryIcon}"
                                              HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                              FontSize="32" Margin="0,0,8,8" Opacity="0.1"/>
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Spacing="2" Margin="12,16,12,0">
                                        <TextBlock Text="{x:Bind GlossaryTitle}" FontWeight="SemiBold" FontSize="14"
                                                   Opacity="0.9" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind GlossaryDescription}" FontSize="12" Opacity="0.7"
                                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Button.Content>
                        </Button>
                    </DataTemplate>
                </muxc:ItemsRepeater>
            </ScrollViewer>
        </Grid>
        <Grid x:Name="ExGlossariesGrid" Grid.Row="2" Visibility="Collapsed">
            <ScrollViewer Padding="0,0">
                <muxc:ItemsRepeater Margin="16,0,16,8" HorizontalAlignment="Center">
                    <muxc:ItemsRepeater.Layout>
                        <muxc:UniformGridLayout Orientation="Horizontal" MinItemWidth="148" MinItemHeight="64"
                                                MinColumnSpacing="6" MinRowSpacing="6" ItemsStretch="Uniform"/>
                    </muxc:ItemsRepeater.Layout>
                </muxc:ItemsRepeater>
            </ScrollViewer>
        </Grid>

        <!-- Original Flint create fields rehosted inline, never in a popup. -->
        <Border x:Name="InlineCreatePanel" Grid.Row="2" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Center" Width="272"
                CornerRadius="8" Padding="16" BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
          <StackPanel Spacing="8">
            <TextBlock Text="创建新的生词本" FontSize="14" FontWeight="SemiBold"/>
            <TextBox x:Name="AddGlossaryNameTextBox" PlaceholderText="生词本的名称" MaxLength="48"/>
            <TextBox x:Name="AddGlossaryDescTextBox" PlaceholderText="描述（可选）" TextWrapping="Wrap"/>
            <TextBlock x:Name="CreateGlossaryStatus" FontSize="11" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button Content="取消" Click="OnCancelCreateClicked"/>
              <Button Content="创建" Style="{StaticResource AccentButtonStyle}" Click="OnCreateGlossaryClicked"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <!--工具栏-->
        <Grid Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="56"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.ColumnSpan="6" Height="1" HorizontalAlignment="Stretch" VerticalAlignment="Top" Fill="{ThemeResource ControlElevationBorderBrush}"/>

            <!--返回-->
            <Button Grid.Column="0" Margin="8,8,0,8" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Center" Click="OnBackClicked">
                <ToolTipService.ToolTip>
                    <ToolTip>
                        <TextBlock>
                            <Run Text="back" FontWeight="Bold"/>
                            <Run Text="/bæk/"/>
                            <Run Text="adverb" FontStyle="Italic" FontWeight="Medium"/>
                            <Run Text="返回"/>
                        </TextBlock>
                    </ToolTip>
                </ToolTipService.ToolTip>
                <muxc:AnimatedIcon Height="22" Width="22" Opacity="0.8">
                    <muxc:AnimatedIcon.Source>
                        <animatedvisuals:AnimatedBackVisualSource/>
                    </muxc:AnimatedIcon.Source>
                    <muxc:AnimatedIcon.FallbackIconSource>
                        <muxc:SymbolIconSource Symbol="Back"/>
                    </muxc:AnimatedIcon.FallbackIconSource>
                </muxc:AnimatedIcon>
            </Button>

            <!--警告-->
            <Button x:Name="WarningButton" Grid.Column="2" Margin="4,8,0,8" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Center" ToolTipService.ToolTip="注意：扩展生词本仅供参考，请勿仅依赖这些词汇进行复习"
                    Visibility="Collapsed">

                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE814;" FontSize="16" Height="22" Width="22" Opacity="0.8"/>
            </Button>

            <!--添加生词本-->
            <Button x:Name="AddGlossaryButton" Grid.Column="3" Margin="4,8,0,8" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Center"
                    Visibility="Visible" Click="OnShowAddGlossaryClicked">
                <ToolTipService.ToolTip>
                    <ToolTip>
                        <TextBlock>
                            <Run Text="add" FontWeight="Bold"/>
                            <Run Text="/æd/"/>
                            <Run Text="verb" FontStyle="Italic" FontWeight="Medium"/>
                            <Run Text="添加"/>
                        </TextBlock>
                    </ToolTip>
                </ToolTipService.ToolTip>

                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE82E;" FontSize="16" Height="22" Width="22" Opacity="0.8"/>
            </Button>
            <controls:PinToggleControl Grid.Column="5" Margin="4,8,8,8"/>
        </Grid>
    </Grid>
</Page>
