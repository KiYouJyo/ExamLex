<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ExamLex.Views.ScoreCalculatorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ExamLex · 英语考试算分器"
    CloseButtonText="关闭"
    DefaultButton="Close">
    <ScrollViewer MaxHeight="570" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" MinWidth="385" Padding="0,4,6,4">
            <TextBlock Text="选择考试类型" FontSize="14" Foreground="#AEBCB7"/>
            <ComboBox x:Name="ExamSelector" HorizontalAlignment="Stretch" SelectionChanged="OnExamChanged">
                <ComboBoxItem Content="TOEFL iBT（2026 新制）"/>
                <ComboBoxItem Content="IELTS（雅思）"/>
                <ComboBoxItem Content="TOEIC Listening &amp; Reading（托业）"/>
            </ComboBox>
            <StackPanel Spacing="4">
                <TextBlock Text="Reading / 阅读"/>
                <NumberBox x:Name="ReadingBox" ValueChanged="OnScoreChanged"
                           SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch"/>
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="Listening / 听力"/>
                <NumberBox x:Name="ListeningBox" ValueChanged="OnScoreChanged"
                           SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch"/>
            </StackPanel>
            <StackPanel x:Name="SpeakingRow" Spacing="4">
                <TextBlock Text="Speaking / 口语"/>
                <NumberBox x:Name="SpeakingBox" ValueChanged="OnScoreChanged"
                           SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch"/>
            </StackPanel>
            <StackPanel x:Name="WritingRow" Spacing="4">
                <TextBlock Text="Writing / 写作"/>
                <NumberBox x:Name="WritingBox" ValueChanged="OnScoreChanged"
                           SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch"/>
            </StackPanel>
            <Border Background="#293A37" CornerRadius="10" Padding="14">
                <StackPanel Spacing="8">
                    <TextBlock Text="计算结果" Foreground="#A5B7B1" FontSize="13"/>
                    <TextBlock x:Name="ResultText" Text="请选择考试" FontSize="26" FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="CefrText" Text="" FontSize="16"/>
                    <TextBlock x:Name="ComparisonText" Text="" FontSize="13"
                               TextWrapping="Wrap" Foreground="#A5B7B1"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="RuleText" FontSize="12" Foreground="#8EA5A0"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
