<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings layout ported from Flint3/Views/SettingsPage.xaml by sh0ckj0ckey (MPL-2.0).
  ExamLex modifications: control bindings, original ExamLex banner, updater actions,
  removal of upstream feedback links and upstream image assets.
  See THIRD_PARTY_NOTICES.md and LICENSES/MPL-2.0.txt.
-->
<Page x:Class="ExamLex.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:labs="using:CommunityToolkit.WinUI.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="52"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="SettingsScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" Padding="0,6,0,12">
        <!-- Flint3's 96-DIP masthead and 16-DIP row margins -->
        <Border x:Name="LogoGrid" Margin="16,0,16,0" Height="96" CornerRadius="4">
          <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#243A3A" Offset="0"/><GradientStop Color="#1D2929" Offset="1"/>
          </LinearGradientBrush></Border.Background>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
            <Border Width="42" Height="42" CornerRadius="10" Background="#4EB59A">
              <TextBlock Text="EL" HorizontalAlignment="Center" VerticalAlignment="Center"
                         FontSize="19" FontWeight="Bold" Foreground="White"/>
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="ExamLex" FontFamily="Times New Roman" FontWeight="SemiBold" FontSize="24" Foreground="White"/>
              <TextBlock Text="English Exam Lexicon" FontSize="13" Foreground="#C6DBD5"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock Text="外观与功能" Margin="20,12,0,8" FontWeight="Bold" FontSize="14"/>
        <labs:SettingsCard  Margin="16,2,16,0" HorizontalAlignment="Stretch" >
  <labs:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE790;"/></labs:SettingsCard.HeaderIcon>
  <labs:SettingsCard.Header><TextBlock Text="主题"/></labs:SettingsCard.Header>
  <labs:SettingsCard.Description><TextBlock Text="选择 ExamLex 的外观" TextWrapping="Wrap"/></labs:SettingsCard.Description>
  <ComboBox x:Name="ThemeBox" MinWidth="128" SelectionChanged="OnPreferenceChanged"><ComboBoxItem Content="跟随系统"/><ComboBoxItem Content="深色"/><ComboBoxItem Content="浅色"/></ComboBox>
</labs:SettingsCard>
        <labs:SettingsCard  Margin="16,2,16,0" HorizontalAlignment="Stretch" >
  <labs:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE727;"/></labs:SettingsCard.HeaderIcon>
  <labs:SettingsCard.Header><TextBlock Text="背景"/></labs:SettingsCard.Header>
  <labs:SettingsCard.Description><TextBlock Text="选择 ExamLex 的背景材质" TextWrapping="Wrap"/></labs:SettingsCard.Description>
  <ComboBox x:Name="BackdropBox" MinWidth="128" SelectionChanged="OnPreferenceChanged"><ComboBoxItem Content="纯色"/><ComboBoxItem Content="云母"/><ComboBoxItem Content="亚克力"/></ComboBox>
</labs:SettingsCard>
        <labs:SettingsCard  Margin="16,2,16,0" HorizontalAlignment="Stretch" >
  <labs:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8F1;"/></labs:SettingsCard.HeaderIcon>
  <labs:SettingsCard.Header><TextBlock Text="英文释义"/></labs:SettingsCard.Header>
  <labs:SettingsCard.Description><TextBlock Text="选择是否显示英英释义" TextWrapping="Wrap"/></labs:SettingsCard.Description>
  <ToggleSwitch x:Name="DefinitionSwitch" Toggled="OnPreferenceChanged"/>
</labs:SettingsCard>
        <labs:SettingsExpander  Margin="16,2,16,0" HorizontalAlignment="Stretch">
  <labs:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE82D;"/></labs:SettingsExpander.HeaderIcon>
  <labs:SettingsExpander.Header><TextBlock Text="生词本"/></labs:SettingsExpander.Header>
  <labs:SettingsExpander.Description><TextBlock Text="选择是否启用生词本功能" TextWrapping="Wrap"/></labs:SettingsExpander.Description>
  <ToggleSwitch x:Name="GlossarySwitch" Toggled="OnPreferenceChanged"/>
  <labs:SettingsExpander.Items><labs:SettingsCard  Margin="16,2,16,0" HorizontalAlignment="Stretch" >
  <labs:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8B7;"/></labs:SettingsCard.HeaderIcon>
  <labs:SettingsCard.Header><TextBlock Text="数据文件"/></labs:SettingsCard.Header>
  <labs:SettingsCard.Description><TextBlock Text="生词本保存在用户本地 ExamLex 文件夹" TextWrapping="Wrap"/></labs:SettingsCard.Description>
  <Button Content="前往查看 ↗" Click="OnGlossaryFolderClicked" Height="32"/>
</labs:SettingsCard></labs:SettingsExpander.Items>
</labs:SettingsExpander>
        <labs:SettingsExpander  Margin="16,2,16,0" HorizontalAlignment="Stretch">
  <labs:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE767;"/></labs:SettingsExpander.HeaderIcon>
  <labs:SettingsExpander.Header><TextBlock Text="朗读单词"/></labs:SettingsExpander.Header>
  <labs:SettingsExpander.Description><TextBlock Text="选择是否启用朗读单词功能" TextWrapping="Wrap"/></labs:SettingsExpander.Description>
  <ToggleSwitch x:Name="TtsSwitch" Toggled="OnPreferenceChanged"/>
  <labs:SettingsExpander.Items><labs:SettingsCard  Margin="16,2,16,0" HorizontalAlignment="Stretch" >
  <labs:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE767;"/></labs:SettingsCard.HeaderIcon>
  <labs:SettingsCard.Header><TextBlock Text="朗读音量"/></labs:SettingsCard.Header>
  <labs:SettingsCard.Description><TextBlock Text="使用 Windows 系统语音" TextWrapping="Wrap"/></labs:SettingsCard.Description>
  <Slider x:Name="VolumeSlider" Width="170" Minimum="0" Maximum="100" StepFrequency="5" ValueChanged="OnVolumeChanged"/>
</labs:SettingsCard></labs:SettingsExpander.Items>
</labs:SettingsExpander>
        <TextBlock Text="行为" Margin="20,12,0,8" FontWeight="Bold" FontSize="14"/>
        <labs:SettingsCard  Margin="16,2,16,0" HorizontalAlignment="Stretch" >
  <labs:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7F4;"/></labs:SettingsCard.HeaderIcon>
  <labs:SettingsCard.Header><TextBlock Text="开机自启动"/></labs:SettingsCard.Header>
  <labs:SettingsCard.Description><TextBlock Text="登录 Windows 时启动 ExamLex（待接入）" TextWrapping="Wrap"/></labs:SettingsCard.Description>
  <ToggleSwitch IsOn="False" IsEnabled="False"/>
</labs:SettingsCard>
        <labs:SettingsCard  Margin="16,2,16,0" HorizontalAlignment="Stretch" >
  <labs:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE765;"/></labs:SettingsCard.HeaderIcon>
  <labs:SettingsCard.Header><TextBlock Text="快捷键"/></labs:SettingsCard.Header>
  <labs:SettingsCard.Description><TextBlock Text="自定义唤醒窗口的快捷键（待接入）" TextWrapping="Wrap"/></labs:SettingsCard.Description>
  <Button Content="设置快捷键" IsEnabled="False" Height="32"/>
</labs:SettingsCard>
        <labs:SettingsCard  Margin="16,2,16,0" HorizontalAlignment="Stretch" >
  <labs:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8A7;"/></labs:SettingsCard.HeaderIcon>
  <labs:SettingsCard.Header><TextBlock Text="快捷窗口"/></labs:SettingsCard.Header>
  <labs:SettingsCard.Description><TextBlock Text="通过快捷键唤出完整或简洁搜索窗口（待接入）" TextWrapping="Wrap"/></labs:SettingsCard.Description>
  <ComboBox MinWidth="128" IsEnabled="False" SelectedIndex="0"><ComboBoxItem Content="完整"/><ComboBoxItem Content="简洁"/></ComboBox>
</labs:SettingsCard>
        <labs:SettingsCard  Margin="16,2,16,0" HorizontalAlignment="Stretch" >
  <labs:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE74D;"/></labs:SettingsCard.HeaderIcon>
  <labs:SettingsCard.Header><TextBlock Text="自动清除"/></labs:SettingsCard.Header>
  <labs:SettingsCard.Description><TextBlock Text="唤醒主页后清除上次输入" TextWrapping="Wrap"/></labs:SettingsCard.Description>
  <ToggleSwitch x:Name="ClearSwitch" Toggled="OnPreferenceChanged"/>
</labs:SettingsCard>
        <labs:SettingsCard  Margin="16,2,16,0" HorizontalAlignment="Stretch" >
  <labs:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8BB;"/></labs:SettingsCard.HeaderIcon>
  <labs:SettingsCard.Header><TextBlock Text="关闭按钮"/></labs:SettingsCard.Header>
  <labs:SettingsCard.Description><TextBlock Text="隐藏至系统托盘（待接入）；当前关闭时退出软件" TextWrapping="Wrap"/></labs:SettingsCard.Description>
  <ComboBox MinWidth="128" SelectedIndex="1" IsEnabled="False"><ComboBoxItem Content="隐藏至托盘"/><ComboBoxItem Content="退出"/></ComboBox>
</labs:SettingsCard>
        <TextBlock Text="搜索" Margin="20,12,0,8" FontWeight="Bold" FontSize="14"/>
        <labs:SettingsExpander  Margin="16,2,16,0" HorizontalAlignment="Stretch">
  <labs:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8AC;"/></labs:SettingsExpander.HeaderIcon>
  <labs:SettingsExpander.Header><TextBlock Text="搜索框样式"/></labs:SettingsExpander.Header>
  <labs:SettingsExpander.Description><TextBlock Text="选择主页搜索框的外观" TextWrapping="Wrap"/></labs:SettingsExpander.Description>
  
  <labs:SettingsExpander.Items><labs:SettingsCard  Margin="16,2,16,0" HorizontalAlignment="Stretch" >
  <labs:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8AC;"/></labs:SettingsCard.HeaderIcon>
  <labs:SettingsCard.Header><TextBlock Text="样式"/></labs:SettingsCard.Header>
  <labs:SettingsCard.Description><TextBlock Text="经典 / 圆角 / 简洁" TextWrapping="Wrap"/></labs:SettingsCard.Description>
  <ComboBox x:Name="SearchStyleBox" MinWidth="156" SelectionChanged="OnPreferenceChanged"><ComboBoxItem Content="经典"/><ComboBoxItem Content="圆角"/><ComboBoxItem Content="简洁"/></ComboBox>
</labs:SettingsCard></labs:SettingsExpander.Items>
</labs:SettingsExpander>
        <TextBlock Text="关于" Margin="20,12,0,8" FontWeight="Bold" FontSize="14"/>
        <labs:SettingsExpander x:Name="AboutSettingsCard" Margin="16,2,16,0" HorizontalAlignment="Stretch">
  <labs:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE946;"/></labs:SettingsExpander.HeaderIcon>
  <labs:SettingsExpander.Header><TextBlock x:Name="AppVersionText" Text="ExamLex"/></labs:SettingsExpander.Header>
  <labs:SettingsExpander.Description><TextBlock Text="ExamLex 是一款开源的离线英语考试词典" TextWrapping="Wrap"/></labs:SettingsExpander.Description>
  <Button Content="检查更新" Height="34" Click="OnAppUpdateClicked"/>
          
  <labs:SettingsExpander.Items><labs:SettingsCard  Margin="16,2,16,0" HorizontalAlignment="Stretch" >
  <labs:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8A7;"/></labs:SettingsCard.HeaderIcon>
  <labs:SettingsCard.Header><TextBlock Text="源代码"/></labs:SettingsCard.Header>
  <labs:SettingsCard.Description><TextBlock Text="前往 GitHub 查看 ExamLex 源代码" TextWrapping="Wrap"/></labs:SettingsCard.Description>
  <Button Content="GitHub 存储库 ↗" Click="OnSourceClicked" Height="34"/>
</labs:SettingsCard><labs:SettingsCard  Margin="16,2,16,0" HorizontalAlignment="Stretch" >
  <labs:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8F1;"/></labs:SettingsCard.HeaderIcon>
  <labs:SettingsCard.Header><TextBlock Text="词典数据库"/></labs:SettingsCard.Header>
  <labs:SettingsCard.Description><TextBlock Text="离线词典数据由 ExamLex-Lexicon 单独维护" TextWrapping="Wrap"/></labs:SettingsCard.Description>
  <StackPanel Spacing="5" HorizontalAlignment="Right" MaxWidth="280">
  <TextBlock x:Name="DatabaseVersionText" Text="尚未安装数据库" Opacity="0.7" FontSize="12" TextAlignment="Right"/>
  <Button x:Name="DatabaseUpdateButton" Content="检查更新" HorizontalAlignment="Right" Click="OnDatabaseUpdateClicked" Height="34"/>
  <TextBlock x:Name="DatabaseUpdateStatus" Text="单独检查词库更新" FontSize="12" TextWrapping="Wrap" MaxWidth="260" Opacity="0.7"/>
</StackPanel>
</labs:SettingsCard></labs:SettingsExpander.Items>
</labs:SettingsExpander>
        <TextBlock x:Name="AppUpdateStatus" Text="应用更新与单词数据库更新彼此独立"
                   FontSize="12" TextWrapping="Wrap" Opacity="0.7" Margin="20,7,16,4"/>
        <TextBlock Text="© 2026 ExamLex contributors · Flint settings UI © sh0ckj0ckey (MPL-2.0)"
                   Margin="20,8,16,10" FontSize="11" Opacity="0.55" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
      <Border Height="1" VerticalAlignment="Top" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>
      <Button HorizontalAlignment="Left" Click="OnBackClicked" Background="Transparent"
              BorderBrush="Transparent" Margin="8,4,0,4" Height="44" ToolTipService.ToolTip="返回词典">
        <FontIcon Glyph="&#xE72B;" FontSize="20" Opacity="0.8"/>
      </Button>
    </Grid>
  </Grid>
</Page>