<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="ExamLex.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="850" HorizontalAlignment="Stretch" Padding="28,16,28,40" Spacing="10">
        <TextBlock Text="设置" FontSize="27" FontWeight="SemiBold" Margin="2,4,0,14"/>
        <TextBlock Text="外观与功能" FontSize="16" FontWeight="SemiBold" Margin="2,8,0,3"/>
        <Border Style="{StaticResource ExamLexSettingsCardStyle}">
          <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="3">
              <TextBlock Text="主题" FontWeight="SemiBold"/>
              <TextBlock Text="选择 ExamLex 的外观" Opacity="0.68" FontSize="12"/>
            </StackPanel>
            <ComboBox x:Name="ThemeBox" Grid.Column="1" MinWidth="160" SelectionChanged="OnPreferenceChanged">
              <ComboBoxItem Content="跟随系统"/><ComboBoxItem Content="深色"/><ComboBoxItem Content="浅色"/>
            </ComboBox>
          </Grid>
        </Border>
        <Border Style="{StaticResource ExamLexSettingsCardStyle}">
          <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="3">
              <TextBlock Text="背景" FontWeight="SemiBold"/>
              <TextBlock Text="实色、云母或亚克力材质" Opacity="0.68" FontSize="12"/>
            </StackPanel>
            <ComboBox x:Name="BackdropBox" Grid.Column="1" MinWidth="160" SelectionChanged="OnPreferenceChanged">
              <ComboBoxItem Content="纯色"/><ComboBoxItem Content="云母"/><ComboBoxItem Content="亚克力"/>
            </ComboBox>
          </Grid>
        </Border>
        <Border Style="{StaticResource ExamLexSettingsCardStyle}">
          <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="3">
              <TextBlock Text="英文释义" FontWeight="SemiBold"/>
              <TextBlock Text="在词条中显示英英释义" Opacity="0.68" FontSize="12"/>
            </StackPanel>
            <ToggleSwitch x:Name="DefinitionSwitch" Grid.Column="1" Toggled="OnPreferenceChanged"/>
          </Grid>
        </Border>
        <Border Style="{StaticResource ExamLexSettingsCardStyle}">
          <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="3">
              <TextBlock Text="生词本" FontWeight="SemiBold"/>
              <TextBlock Text="允许收藏查询结果，保存在本机" Opacity="0.68" FontSize="12"/>
            </StackPanel>
            <ToggleSwitch x:Name="GlossarySwitch" Grid.Column="1" Toggled="OnPreferenceChanged"/>
          </Grid>
        </Border>
        <Border Style="{StaticResource ExamLexSettingsCardStyle}">
          <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="3">
              <TextBlock Text="朗读单词" FontWeight="SemiBold"/>
              <TextBlock Text="使用 Windows 系统语音朗读词条" Opacity="0.68" FontSize="12"/>
            </StackPanel>
            <ToggleSwitch x:Name="TtsSwitch" Grid.Column="1" Toggled="OnPreferenceChanged"/>
          </Grid>
        </Border>
        <Border Style="{StaticResource ExamLexSettingsCardStyle}">
          <StackPanel Spacing="8">
            <TextBlock Text="朗读音量" FontWeight="SemiBold"/>
            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100"
                    StepFrequency="5" ValueChanged="OnVolumeChanged"/>
          </StackPanel>
        </Border>
        <TextBlock Text="行为" FontSize="16" FontWeight="SemiBold" Margin="2,18,0,3"/>
        <Border Style="{StaticResource ExamLexSettingsCardStyle}">
          <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="3">
              <TextBlock Text="自动清除" FontWeight="SemiBold"/>
              <TextBlock Text="从其他页面返回查词时清空搜索框" Opacity="0.68" FontSize="12"/>
            </StackPanel>
            <ToggleSwitch x:Name="ClearSwitch" Grid.Column="1" Toggled="OnPreferenceChanged"/>
          </Grid>
        </Border>
        <Border Style="{StaticResource ExamLexSettingsCardStyle}">
          <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="3">
              <TextBlock Text="搜索框样式" FontWeight="SemiBold"/>
              <TextBlock Text="切换主页搜索框轮廓" Opacity="0.68" FontSize="12"/>
            </StackPanel>
            <ComboBox x:Name="SearchStyleBox" Grid.Column="1" MinWidth="160" SelectionChanged="OnPreferenceChanged">
              <ComboBoxItem Content="经典"/><ComboBoxItem Content="圆角"/><ComboBoxItem Content="简洁"/>
            </ComboBox>
          </Grid>
        </Border>
        <Border Style="{StaticResource ExamLexSettingsCardStyle}">
          <StackPanel Spacing="5">
            <TextBlock Text="快捷窗口 / 快捷键 / 开机自启" FontWeight="SemiBold"/>
            <TextBlock Text="Flint 的系统级热键和启动任务依赖其自身平台服务，ExamLex 尚未实现；不会提供无法生效的开关。"
                       FontSize="12" Opacity="0.68" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <TextBlock Text="关于" FontSize="16" FontWeight="SemiBold" Margin="2,18,0,3"/>
        <Border Style="{StaticResource ExamLexSettingsCardStyle}">
          <StackPanel Spacing="12">
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Spacing="4">
                <TextBlock Text="ExamLex 0.1.1" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="独立的开源英语考试词典 · Windows WinUI 3" Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>
              <Button Grid.Column="1" Content="检查更新" Click="OnAppUpdateClicked"/>
            </Grid>
            <TextBlock x:Name="AppUpdateStatus" Text="软件更新与词库更新互相独立" FontSize="12" TextWrapping="Wrap" Opacity="0.75"/>
            <Button Content="GitHub 存储库" HorizontalAlignment="Left" Click="OnSourceClicked"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource ExamLexSettingsCardStyle}">
          <StackPanel Spacing="12">
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Spacing="4">
                <TextBlock Text="ExamLex-Lexicon · 单词数据库" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="DatabaseVersionText" Text="本机未安装词库" Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>
              <Button x:Name="DatabaseUpdateButton" Grid.Column="1" Content="检查更新"
                      Click="OnDatabaseUpdateClicked"/>
            </Grid>
            <TextBlock x:Name="DatabaseUpdateStatus" Text="独立从 ExamLex-Lexicon 的公开版本检查、下载并验证数据库；不随软件整体重装。"
                       FontSize="12" TextWrapping="Wrap" Opacity="0.75"/>
          </StackPanel>
        </Border>
        <TextBlock Text="© 2026 ExamLex contributors · UI inspired by Flint (MPL-2.0)"
                   Margin="4,16,0,0" FontSize="11" Opacity="0.55" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
</Page>
