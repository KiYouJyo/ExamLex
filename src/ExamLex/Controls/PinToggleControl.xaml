<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ExamLex.Controls.PinToggleControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ToggleButton x:Name="PinToggle" Background="Transparent" BorderBrush="Transparent"
        VerticalAlignment="Center" HorizontalAlignment="Center"
        Click="OnPinClicked" ToolTipService.ToolTip="窗口置顶" AutomationProperties.Name="窗口置顶">
    <Grid Width="22" Height="22">
      <FontIcon x:Name="UnpinnedIcon" FontFamily="{StaticResource SymbolThemeFontFamily}"
          Glyph="&#xE141;" FontSize="16" Width="22" Height="22" Opacity="0.8"/>
      <FontIcon x:Name="PinnedIcon" FontFamily="{StaticResource SymbolThemeFontFamily}"
          Glyph="&#xE196;" FontSize="16" Width="22" Height="22" Opacity="0.8" Visibility="Collapsed"/>
    </Grid>
  </ToggleButton>
</UserControl>